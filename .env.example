# Internal session identifier embedded in the system prompt.
# Keep this value secret in .env and never commit real sensitive data.
SESSION_ID=999-00-1234

# Hugging Face model ID used by the target bot generation backend.
# Override this to swap to a different compatible instruct/chat model.
# Qwen2.5-0.5B-Instruct: weakly aligned, easy to jailbreak, 8 instances fit on A10G (recommended for prototyping)
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# MODEL_ID=openai-community/gpt2              # raw completion model, no instruction following
# MODEL_ID=microsoft/Phi-3-mini-4k-instruct   # strongly aligned, ~7.4 GB/instance, max 3 on A10G

# Microsoft Teams incoming webhook URL for training notifications.
# Create one via Teams channel → Connectors → Incoming Webhook.
TEAMS_WEBHOOK_URL=
