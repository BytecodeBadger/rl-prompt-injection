# Internal session identifier embedded in the system prompt.
# Keep this value secret in .env and never commit real sensitive data.
SESSION_ID=999-00-1234

# Hugging Face model ID used by the target bot generation backend.
# Override this to swap to a different compatible instruct/chat model.
# MODEL_ID=microsoft/Phi-3-mini-4k-instruct
MODEL_ID=openai-community/gpt2
